{
  "name": "@yaqmc/client",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Host-agnostic YAQMC client SDK. Frontend consumption starts in P6 except the seek-adapter re-export.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
