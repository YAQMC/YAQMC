  "type": "module",
  "description": "YAQMC Electron host. Parallel to the Tauri shim until P13.",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
