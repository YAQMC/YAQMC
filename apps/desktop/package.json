    "smoke": "npm run build && node ./scripts/smoke.mjs",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@yaqmc/client": "*"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "esbuild": "^0.25.12"
  }
}
