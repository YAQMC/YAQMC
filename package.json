{
  "name": "yaqmc",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "node scripts/check-public-docs.mjs",
    "plugins:pack": "node scripts/pack-example-plugins.mjs",
    "plugin:build": "node scripts/build-plugin-examples.mjs",
    "plugin:validate": "node scripts/validate-example-plugins.mjs",
    "plugin:pack": "npm run plugin:build && npm run plugin:validate && node scripts/pack-example-plugins.mjs",
    "pages:build": "node scripts/build-pages.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run docs:check && npm run lint && npm run test && npm run build",
    "ci:frontend-build": "tsc -b && vite build && node scripts/ci/write-frontend-build-info.mjs",
    "ci:package-metadata": "node scripts/ci/write-build-info.mjs",
    "ci:test-scripts": "node --test scripts/ci/*.test.mjs",
    "ci:verify-workspace": "node scripts/ci/verify-workspace-contract.mjs",
    "provenance:report": "node scripts/validate-provenance-ledger.mjs",
    "provenance:enforce": "node scripts/validate-provenance-ledger.mjs --enforce",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "stackblur-canvas": "^3.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
