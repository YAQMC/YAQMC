{
  "manifestVersion": 1,
  "id": "dev.yaqmc.example.now-playing",
  "name": "Session bookmark",
  "description": "Reads track, lyrics, player, and theme; stores a bookmark; restores seek on the same queue entry. Uses every v1 script event.",
  "version": "1.0.0",
  "apiVersion": 1,
  "authors": ["YAQMC examples"],
  "homepage": "https://github.com/YAQMC/YAQMC",
  "repository": "https://github.com/YAQMC/YAQMC",
  "license": "MIT",
  "engines": { "yaqmc": ">=0.1.0" },
  "platforms": ["windows", "linux"],
  "entrypoints": {
    "script": "dist/main.js"
  },
  "permissions": [
    "track.read",
    "lyrics.read",
    "player.read",
    "player.control",
    "theme.read",
    "plugin.storage"
  ]
}
